# ── Hybrid AI Architecture (Groq for Text + Gemini for Images & Failover) ─
# Primary text chat & document/presentation generation (stateless)
# Free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# ── Google Gemini API (Image Generation & Text Failover) ───────────────────
# Exclusively used for text-to-image and natural image editing (/generate-image)
# Also serves as automatic failover if Groq encounters rate limits or errors
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# ── Local Ollama (Optional Offline Fallback) ────────────────────────────────
# URL of your running Ollama instance (default: local)
OLLAMA_BASE_URL=http://localhost:11434

# Text generation model
OLLAMA_MODEL=gemma4:26b

# Vision/image model
OLLAMA_VISION_MODEL=llava:latest

# ── Web Search ──────────────────────────────────────────────────────────────
# Choose your provider: "tavily" (recommended) or "serper"
SEARCH_PROVIDER=tavily

# Tavily API Key — get one free at https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Serper API Key — get one at https://serper.dev (alternative to Tavily)
# SERPER_API_KEY=your_serper_api_key_here

# Max search results to include in the LLM prompt
SEARCH_MAX_RESULTS=5

# ── CORS ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["*"]

# ── Image Upload ────────────────────────────────────────────────────────────
MAX_IMAGE_SIZE_MB=10

# ── Zero Data Retention (do not change) ─────────────────────────────────────
ZERO_DATA_RETENTION=true
LOG_USER_MESSAGES=false
