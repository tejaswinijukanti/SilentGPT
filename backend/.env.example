# ── Ollama ──────────────────────────────────────────────────────────────────
# URL of your running Ollama instance (default: local)
OLLAMA_BASE_URL=http://localhost:11434

# Text generation model (phi3:mini is free, fast, runs on CPU)
OLLAMA_MODEL=phi3:mini

# Vision/image model (uncomment one — requires GPU for best performance)
# OLLAMA_VISION_MODEL=phi3:vision
# OLLAMA_VISION_MODEL=llava:7b
OLLAMA_VISION_MODEL=phi3:vision


# ── Web Search ──────────────────────────────────────────────────────────────
# Choose your provider: "tavily" (recommended) or "serper"
SEARCH_PROVIDER=tavily

# Tavily API Key — get one free at https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Serper API Key — get one at https://serper.dev (alternative to Tavily)
# SERPER_API_KEY=your_serper_api_key_here

# Max search results to include in the LLM prompt
SEARCH_MAX_RESULTS=5


# ── CORS ────────────────────────────────────────────────────────────────────
# For development: allow all origins
# For production: replace with your frontend URL (comma-separated)
# ALLOWED_ORIGINS=["https://your-silentgpt-frontend.com"]
ALLOWED_ORIGINS=["*"]


# ── Image Upload ────────────────────────────────────────────────────────────
# Maximum image size in MB (requests above this are rejected)
MAX_IMAGE_SIZE_MB=10


# ── Zero Data Retention (do not change) ─────────────────────────────────────
ZERO_DATA_RETENTION=true
LOG_USER_MESSAGES=false

# ── Gemini API Key ──────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
